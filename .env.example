POSTGRES_DB=stork_edit
POSTGRES_USER=stork_edit
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://stork_edit:replace-with-a-long-random-password@db:5432/stork_edit
JWT_SECRET=replace-with-at-least-48-random-characters
# Optional separate stable key for recovering saved Survey links in Edit campaign.
# If omitted, JWT_SECRET is used. Changing either active key makes previously saved links unrecoverable.
SURVEY_LINK_ENCRYPTION_KEY=replace-with-a-stable-random-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-with-a-separate-random-token-at-least-24-characters
JWT_EXPIRES_IN=30d
PORT=3000
PUBLIC_API_URL=https://bielik.myqnapcloud.com:18444
PUBLIC_APP_URL=https://jankowiakl.github.io/stork_edit2/
PROJECT_CONTACT_NAME=White Stork research team
PROJECT_CONTACT_EMAIL=
PROJECT_CONTACT_URL=
CORS_ORIGIN=https://jankowiakl.github.io
PHOTO_DIR=/data/photos
MAX_PHOTO_MB=30
MAX_IMPORT_FILE_MB=4096
MAX_IMPORT_ENTRIES=10000
PHOTO_GPS_MAX_OFFSET_MINUTES=90
TRUST_PROXY=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stork Photo Editor <noreply@example.com>"
